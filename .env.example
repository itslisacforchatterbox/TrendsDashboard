# ==============================================================================
# Google Cloud Service Account & Google Sheets
# ==============================================================================
# Local testing: Provide the relative or absolute path to your JSON key file:
GCP_SA_CREDENTIALS="service_account.json"
# Production / GitHub Actions: Replace with the raw JSON string:
# GCP_SA_CREDENTIALS='{"type": "service_account", "project_id": "...", ...}'

# The Google Sheet Document ID (found in the URL: /d/<GOOGLE_SHEET_ID>/edit)
GOOGLE_SHEET_ID="your_google_sheet_id_here"

# ==============================================================================
# AI Extraction (Google Gemini 3.8 / Flash)
# ==============================================================================
# Primary Gemini API Key
GEMINI_API_KEY="AIzaSyPrimary..."

# Backup Keys (Automatically activated if the primary hits 429 / daily quota)
GEMINI_API_KEY_BACKUP="AIzaSyBackup1..."
GEMINI_API_KEY_BACKUP_2="AIzaSyBackup2..."

# ==============================================================================
# Stage A: Scraping & Ingestion Credentials
# ==============================================================================
# Apify Free Tier ($5.00/month recurring credit) for TikTok Creative Center
APIFY_API_TOKEN="apify_api_..."

# Official Google Cloud YouTube Data API v3 key (AU trending music queries)
YOUTUBE_API_KEY="AIzaSy..."

# ==============================================================================
# Feature-Flagged / Optional Ingestion Sources
# ==============================================================================
# Spotify Web API (Client Credentials Flow - leave blank if not yet provisioned)
SPOTIFY_CLIENT_ID=""
SPOTIFY_CLIENT_SECRET=""

# TokInsight on RapidAPI (leave blank to skip)
RAPIDAPI_KEY=""